// ============================================================
// NAAP Library System — ERD (DBML for dbdiagram.io)
// ============================================================

enum tbl_access_attempts_STATUS_enum {
  "success"
  "failed"
}

enum surveys_STATUS_enum {
  "draft"
  "active"
  "closed"
}

enum survey_questions_TYPE_enum {
  "short_text"
  "paragraph"
  "multiple_choice"
  "checkboxes"
  "dropdown"
  "rating"
  "date"
}

enum chat_messages_role_enum {
  "user"
  "assistant"
  "system"
}

// ─────────────── LARAVEL CACHE / QUEUE / SESSION TABLES ────

Table cache {
  key varchar(255) [pk, not null]
  value mediumtext [not null]
  expiration int [not null]
}

Table cache_locks {
  key varchar(255) [pk, not null]
  owner varchar(255) [not null]
  expiration int [not null]
}

Table failed_jobs {
  id bigint [pk, increment, not null]
  uuid varchar(255) [not null, unique]
  connection text [not null]
  queue text [not null]
  payload longtext [not null]
  exception longtext [not null]
  failed_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table jobs {
  id bigint [pk, increment, not null]
  queue varchar(255) [not null]
  payload longtext [not null]
  attempts tinyint [not null]
  reserved_at int
  available_at int [not null]
  created_at int [not null]
}

Table job_batches {
  id varchar(255) [pk, not null]
  name varchar(255) [not null]
  total_jobs int [not null]
  pending_jobs int [not null]
  failed_jobs int [not null]
  failed_job_ids longtext [not null]
  options mediumtext
  cancelled_at int
  created_at int [not null]
  finished_at int
}

Table migrations {
  id int [pk, increment, not null]
  migration varchar(255) [not null]
  batch int [not null]
}

Table password_reset_tokens {
  email varchar(255) [pk, not null]
  token varchar(255) [not null]
  created_at timestamp
}

Table sessions {
  id varchar(255) [pk, not null]
  user_id bigint
  ip_address varchar(45)
  user_agent text
  payload longtext [not null]
  last_activity int [not null]
}

// ─────────────── AUTH TABLE ─────────────────────────────────

Table users {
  id bigint [pk, increment, not null]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  email_verified_at timestamp
  password varchar(255) [not null]
  two_factor_secret text
  two_factor_recovery_codes text
  two_factor_confirmed_at timestamp
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
}

// ─────────────── STUDENT TABLES ─────────────────────────────

Table tbl_student_info {
  LIBRARY_ID varchar(255) [pk, not null, note: 'Format: YY-NNNNN e.g. 26-00001']
  STUDENT_RFID_NUMBER varchar(255)
  STUDENT_NUMBER varchar(255)
  FN varchar(255)
  MN varchar(255)
  LN varchar(255)
  SEX varchar(255)
  BIRTHDAY varchar(255)
  CONTACT_NUMBER varchar(255)
  EMAIL varchar(255)
  QR_SENT tinyint(1) [not null, default: 0]
  PIC varchar(255)
  COURSE varchar(255)
  ADDRESS varchar(255)
  REGISTERED_ON date
  RENEW_ON date
  ID_STATUS varchar(255)
  ID_STATUS_DATE date
  FACE_EMBEDDING json
}

Table tbl_student_logs {
  id bigint [pk, increment, not null]
  LIBRARY_ID varchar(255) [not null]
  LOG_TIME time [not null]
  LOG_DATE date [not null]
  LOG_SESSION varchar(255) [not null]
  LOG_IMAGE varchar(255)
}

Table tbl_access_attempts {
  id bigint [pk, increment, not null]
  LIBRARY_ID varchar(255)
  STATUS tbl_access_attempts_STATUS_enum [not null]
  IMAGE_PATH varchar(255)
  ATTEMPT_TYPE varchar(255) [not null]
  LOG_DATE date [not null]
  LOG_TIME time [not null]
  created_at timestamp
  updated_at timestamp
}

// ─────────────── LOCKER / DEPOSITORY TABLES ─────────────────

Table tbl_rfid_info {
  RFID_NUMBER varchar(255) [pk, not null]
  LOCKER_NUMBER int
  IS_AVAILABLE varchar(255) [not null, default: 'Yes']
}

Table tbl_rfidhistory {
  id bigint [pk, increment, not null]
  RFID_CARD_NUMBER varchar(255) [not null]
  LIBRARY_ID varchar(255) [not null]
  BORROW_ON datetime [not null]
  RETURN_ON datetime
  LOCKER_NUMBER varchar(255)
  EMP_ID varchar(255)
}

// ─────────────── REPORTS / COMMUNICATION ────────────────────

Table tbl_lost_id_reports {
  id bigint [pk, increment, not null]
  old_library_id varchar(255) [not null]
  new_library_id varchar(255)
  student_number varchar(255) [not null]
  location_lost varchar(255) [not null]
  description text
  affidavit_path varchar(255) [not null]
  processed_by bigint
  created_at timestamp
  updated_at timestamp
}

Table email_messages {
  id bigint [pk, increment, not null]
  library_id varchar(255)
  subject varchar(255) [not null]
  body longtext [not null]
  attachments varchar(255)
  sent_to varchar(255)
  is_read tinyint(1) [not null, default: 1]
  created_at timestamp
  updated_at timestamp
}

// ─────────────── SURVEY TABLES ──────────────────────────────

Table surveys {
  id bigint [pk, increment, not null]
  title varchar(255) [not null]
  description text
  status surveys_STATUS_enum [not null, default: 'draft']
  created_by bigint
  created_at timestamp
  updated_at timestamp
}

Table survey_questions {
  id bigint [pk, increment, not null]
  survey_id bigint [not null]
  order int [not null, default: 0]
  type survey_questions_TYPE_enum [not null, default: 'short_text']
  label text [not null]
  options json
  required tinyint(1) [not null, default: 0]
  created_at timestamp
  updated_at timestamp
}

Table survey_responses {
  id bigint [pk, increment, not null]
  survey_id bigint [not null]
  respondent_name varchar(255)
  respondent_email varchar(255)
  answers json [not null]
  submitted_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

// ─────────────── CONFIGURATION TABLES ───────────────────────

Table tbl_sensitivity_thresholds {
  id bigint [pk, increment, not null]
  key varchar(255) [not null, unique]
  value decimal(3,2) [not null]
  description varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table tbl_settings {
  id bigint [pk, increment, not null]
  key varchar(255) [not null, unique]
  value text
  description varchar(255)
  created_at timestamp
  updated_at timestamp
}

// ─────────────── AUDIT / LOGGING TABLES ─────────────────────

Table audit_trails {
  id bigint [pk, increment, not null]
  user_id bigint
  user_name varchar(255)
  auditable_type varchar(255) [not null]
  auditable_id varchar(255) [not null]
  event varchar(255) [not null]
  activity text
  ip_address varchar(45)
  old_values json
  new_values json
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

// ─────────────── CALENDAR / NOTES TABLES ────────────────────

Table calendar_notes {
  id bigint [pk, increment, not null]
  date date [not null]
  time time
  note text [not null]
  created_at timestamp
  updated_at timestamp
}

// ─────────────── AI CHAT TABLES ─────────────────────────────

Table chats {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  title varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table chat_messages {
  id bigint [pk, increment, not null]
  chat_id bigint [not null]
  role chat_messages_role_enum [not null]
  content text [not null]
  created_at timestamp
  updated_at timestamp
}

// ─────────────── RELATIONSHIPS ──────────────────────────────

Ref: sessions.user_id > users.id
Ref: tbl_student_logs.LIBRARY_ID > tbl_student_info.LIBRARY_ID
Ref: tbl_access_attempts.LIBRARY_ID > tbl_student_info.LIBRARY_ID
Ref: tbl_rfidhistory.LIBRARY_ID > tbl_student_info.LIBRARY_ID
Ref: tbl_rfidhistory.RFID_CARD_NUMBER > tbl_rfid_info.RFID_NUMBER
Ref: tbl_rfidhistory.EMP_ID > users.id
Ref: tbl_lost_id_reports.processed_by > users.id
Ref: email_messages.library_id > tbl_student_info.LIBRARY_ID
Ref: surveys.created_by > users.id
Ref: survey_questions.survey_id > surveys.id
Ref: survey_responses.survey_id > surveys.id
Ref: audit_trails.user_id > users.id
Ref: chats.user_id > users.id
Ref: chat_messages.chat_id > chats.id
